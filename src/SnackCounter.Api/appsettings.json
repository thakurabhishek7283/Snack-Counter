{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Persistence": { "Provider": "InMemory" },
  "ConnectionStrings": {
    "Snack": "Host=localhost;Port=5432;Database=snack;Username=snack;Password=snack"
  },
  "Database": { "MigrateOnStartup": true },
  "Seed": { "Demo": true },

  "Jobs": {
    "Enabled": true,
    "SweepInterval": "00:01:00",
    "OutboxInterval": "00:00:05",
    "ClaimSyncInterval": "01:00:00",
    "ResumeInterval": "01:00:00"
  },

  "Assignment": {
    "OfferTtl": "02:00:00",
    "PurchaseWindow": "1.00:00:00",
    "ReminderAtFraction": 0.5,
    "MaxDirectedOffers": 3,
    "OutstandingClaimsCap": 2,
    "Weights": { "FewestRecentRefills": 0.5, "LongestSinceLastRefill": 0.3, "InOfficeToday": 0.2 }
  },
  "Reimbursement": { "OverdueAfter": "10.00:00:00" },
  "Reporting": { "Currency": "NOK" },
  "Fx": { "Rates": { "INR->NOK": 0.125 } },

  "Cors": { "Origins": [ "http://localhost:4200" ] }
}
